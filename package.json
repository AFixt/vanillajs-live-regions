{
  "name": "@afixt/vanilla-live-regions",
  "version": "1.0.1",
  "title": "Vanilla JS Live Regions",
  "description": "Vanilla JavaScript library for managing ARIA live regions",
  "keywords": [
    "Accessibility",
    "WAI-ARIA",
    "Live Regions",
    "WCAG",
    "a11y"
  ],
  "author": {
    "name": "Karl Groves",
    "email": "karl.groves@afixt.com",
    "url": "http://www.afixt.com"
  },
  "type": "module",
  "main": "./dist/liveRegion.js",
  "module": "./dist/liveRegion.mjs",
  "exports": {
    ".": {
      "import": "./dist/liveRegion.mjs",
      "require": "./dist/liveRegion.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js test/**/*.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AFixt/vanillajs-live-regions.git"
  },
  "bugs": {
    "url": "https://github.com/AFixt/vanillajs-live-regions/issues"
  },
  "license": "MIT"
}
